{
  "name": "agentic-review",
  "version": "1.0.1",
  "description": "CLI tool that reviews Git PR diffs using the Claude Agent SDK",
  "license": "MIT",
  "keywords": [
    "cli",
    "code-review",
    "github",
    "pull-request",
    "claude",
    "ai"
  ],
  "type": "module",
  "bin": {
    "agentic-review": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "npx tsx src/index.ts",
    "lint": "tsc",
    "build": "vite build",
    "prepublishOnly": "npm run build",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.132",
    "@octokit/rest": "^22.0.1",
    "chalk": "^5.4.1",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.3",
    "vitest": "^3.1.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
